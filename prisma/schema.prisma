generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  password     String
  role         UserRole      @default(USER)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id                String          @id @default(uuid())
  amount            Decimal
  currency          String          @default("IRR")
  type              TransactionType
  category          String
  description       String?
  source            String
  destination       String
  previousHash      String?         @unique
  hash              String          @unique
  createdAt         DateTime        @default(now())
  nextTransactionId String?         @unique
  createdById       String?
  createdBy         User?           @relation(fields: [createdById], references: [id])
  nextTransaction   Transaction?    @relation("TransactionChain", fields: [nextTransactionId], references: [id])
  prevTransaction   Transaction?    @relation("TransactionChain")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  USER
  ADMIN
}
